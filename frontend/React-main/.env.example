# Copy this file to .env and fill in your values. Vite only exposes vars
# prefixed with VITE_ to client code (see src/lib/supabaseClient.ts / apiClient.ts).

# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Go backend from Step 3 (Golang-main), local dev default shown
VITE_API_BASE_URL=http://localhost:8080/api/v1
