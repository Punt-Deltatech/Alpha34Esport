# Copy this file to .env and update values for your environment.
#
# DATABASE_URL: Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
#   Use the "Session pooler" or "Transaction pooler" string for serverless/edge deploys,
#   or the direct connection string for a long-lived Go process like this one.
# Currently pointed at the LOCAL Supabase stack (npx supabase start, run from the repo root).
# Swap for the cloud connection string when deploying for real.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# SUPABASE_URL: Supabase dashboard -> Project Settings -> API -> Project URL.
# Needed to verify ES256-signed tokens (Supabase's current default "JWT Signing Keys") against
# the project's JWKS endpoint. Points at the local stack for now.
SUPABASE_URL=http://127.0.0.1:54321

# SUPABASE_JWT_SECRET: Supabase dashboard -> Project Settings -> API -> JWT Secret.
# Only needed for projects still on the legacy HS256 shared-secret scheme — harmless to leave
# set even when SUPABASE_URL/ES256 is what's actually verifying tokens.
# This is the well-known default local-dev secret `supabase start` always uses — not sensitive.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

SERVER_PORT=8080

# Local disk folder for Portfolio / DocumentURL / ProofImageURL / PaymentEvidence uploads.
UPLOAD_DIR=./uploads
